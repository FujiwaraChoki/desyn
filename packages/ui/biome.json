{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": false,
  "extends": "//",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": ["**", "!playground/dist", "!playground/screenshots"]
  },
  "overrides": [
    {
      "includes": ["src/components/data-table.tsx"],
