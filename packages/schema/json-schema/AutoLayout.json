{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desyn.app/schema/v1/AutoLayout.json",
  "title": "AutoLayout",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["row", "column", "grid"]
    },
    "gap": {
      "type": "number"
    },
    "rowGap": {
      "type": "number"
    },
    "padding": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "mainAlign": {
      "type": "string",
      "enum": ["start", "center", "end", "space-between"]
    },
    "crossAlign": {
      "type": "string",
      "enum": ["start", "center", "end", "stretch", "baseline"]
    },
    "wrap": {
      "type": "boolean"
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reverse": {
      "type": "boolean"
    }
  },
  "required": ["mode", "gap", "padding", "mainAlign", "crossAlign"],
  "additionalProperties": {}
}
