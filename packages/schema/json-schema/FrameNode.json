{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desyn.app/schema/v1/FrameNode.json",
  "title": "FrameNode",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/Id"
    },
    "name": {
      "type": "string"
    },
    "parent": {
      "$ref": "#/$defs/NodeId"
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "width": {
      "type": "number",
      "minimum": 0
    },
    "height": {
      "type": "number",
      "minimum": 0
    },
    "rotation": {
      "type": "number"
    },
    "flipX": {
      "type": "boolean"
    },
    "flipY": {
      "type": "boolean"
    },
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "blend": {
      "$ref": "#/$defs/BlendMode"
    },
    "visible": {
      "type": "boolean"
    },
    "locked": {
      "type": "boolean"
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Effect"
      }
    },
    "role": {
      "type": "string"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "h": {
          "type": "string",
          "enum": ["left", "right", "center", "stretch", "scale"]
        },
        "v": {
          "type": "string",
          "enum": ["top", "bottom", "center", "stretch", "scale"]
        }
      },
      "required": ["h", "v"],
      "additionalProperties": {}
    },
    "sizing": {
      "type": "object",
      "properties": {
        "h": {
          "type": "string",
          "enum": ["fixed", "hug", "fill"]
        },
        "v": {
          "type": "string",
          "enum": ["fixed", "hug", "fill"]
        }
      },
      "required": ["h", "v"],
      "additionalProperties": {}
    },
    "aspectLocked": {
      "type": "boolean"
    },
    "mask": {
      "type": "boolean"
    },
    "link": {
      "type": "string"
    },
    "alt": {
      "type": "string"
    },
    "anim": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Animation"
      }
    },
    "notes": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      }
    },
    "clip": {
      "type": "boolean"
    },
    "layout": {
      "$ref": "#/$defs/AutoLayout"
    },
    "fills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Fill"
      }
    },
    "strokes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Stroke"
      }
    },
    "cornerRadius": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      ]
    },
    "cornerSmoothing": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "type": {
      "type": "string",
      "const": "frame"
    }
  },
  "required": [
    "id",
    "name",
    "parent",
    "x",
    "y",
    "width",
    "height",
    "rotation",
    "opacity",
    "blend",
    "visible",
    "locked",
    "effects",
    "children",
    "clip",
    "fills",
    "strokes",
    "cornerRadius",
    "type"
  ],
  "additionalProperties": {},
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z0-9]{12}$"
    },
    "NodeId": {
      "anyOf": [
        {
          "$ref": "#/$defs/Id"
        },
        {
          "type": "string",
          "const": "root"
        }
      ]
    },
    "BlendMode": {
      "type": "string",
      "enum": [
        "normal",
        "multiply",
        "screen",
        "overlay",
        "darken",
        "lighten",
        "color-dodge",
        "color-burn",
        "hard-light",
        "soft-light",
        "difference",
        "exclusion",
        "hue",
        "saturation",
        "color",
        "luminosity"
      ]
    },
    "Effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dropShadow"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "blur": {
              "type": "number",
              "minimum": 0
            },
            "spread": {
              "type": "number"
            },
            "color": {
              "$ref": "#/$defs/Color"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "x", "y", "blur", "spread", "color"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "innerShadow"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "blur": {
              "type": "number",
              "minimum": 0
            },
            "spread": {
              "type": "number"
            },
            "color": {
              "$ref": "#/$defs/Color"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "x", "y", "blur", "spread", "color"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "layerBlur"
            },
            "radius": {
              "type": "number",
              "minimum": 0
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "radius"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "backgroundBlur"
            },
            "radius": {
              "type": "number",
              "minimum": 0
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "radius"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "noise"
            },
            "amount": {
              "type": "number"
            },
            "scale": {
              "type": "number"
            },
            "mono": {
              "type": "boolean"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "amount", "scale", "mono"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "glow"
            },
            "radius": {
              "type": "number",
              "minimum": 0
            },
            "strength": {
              "type": "number"
            },
            "color": {
              "$ref": "#/$defs/Color"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "radius", "strength", "color"],
          "additionalProperties": {}
        }
      ]
    },
    "Color": {
      "type": "string",
      "pattern": "^#(?:[0-9a-f]{6}|[0-9a-f]{8})$"
    },
    "Animation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "preset": {
          "type": "string",
          "enum": [
            "fade",
            "rise",
            "drop",
            "slide-left",
            "slide-right",
            "zoom-in",
            "zoom-out",
            "pop",
            "rotate",
            "wipe",
            "typewriter",
            "pulse",
            "float",
            "shake",
            "blur-in",
            "none"
          ]
        },
        "phase": {
          "type": "string",
          "enum": ["in", "out", "loop"]
        },
        "startMs": {
          "type": "number"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "easing": {
          "type": "string",
          "enum": ["linear", "ease", "ease-in", "ease-out", "ease-in-out", "spring"]
        }
      },
      "required": ["id", "preset", "phase", "startMs", "durationMs", "easing"],
      "additionalProperties": {}
    },
    "AutoLayout": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["row", "column", "grid"]
        },
        "gap": {
          "type": "number"
        },
        "rowGap": {
          "type": "number"
        },
        "padding": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "mainAlign": {
          "type": "string",
          "enum": ["start", "center", "end", "space-between"]
        },
        "crossAlign": {
          "type": "string",
          "enum": ["start", "center", "end", "stretch", "baseline"]
        },
        "wrap": {
          "type": "boolean"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reverse": {
          "type": "boolean"
        }
      },
      "required": ["mode", "gap", "padding", "mainAlign", "crossAlign"],
      "additionalProperties": {}
    },
    "Fill": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "solid"
            },
            "color": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Color"
                },
                {
                  "$ref": "#/$defs/ColorRef"
                }
              ]
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            },
            "blend": {
              "$ref": "#/$defs/BlendMode"
            }
          },
          "required": ["type", "color"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "linear"
            },
            "angle": {
              "type": "number"
            },
            "stops": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Stop"
              }
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            },
            "blend": {
              "$ref": "#/$defs/BlendMode"
            }
          },
          "required": ["type", "angle", "stops"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "radial"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "rx": {
              "type": "number"
            },
            "ry": {
              "type": "number"
            },
            "stops": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Stop"
              }
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            },
            "blend": {
              "$ref": "#/$defs/BlendMode"
            }
          },
          "required": ["type", "cx", "cy", "rx", "ry", "stops"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "conic"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "angle": {
              "type": "number"
            },
            "stops": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Stop"
              }
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            },
            "blend": {
              "$ref": "#/$defs/BlendMode"
            }
          },
          "required": ["type", "cx", "cy", "angle", "stops"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            },
            "assetId": {
              "$ref": "#/$defs/Id"
            },
            "mode": {
              "type": "string",
              "enum": ["fill", "fit", "tile", "stretch"]
            },
            "scale": {
              "type": "number"
            },
            "offsetX": {
              "type": "number"
            },
            "offsetY": {
              "type": "number"
            },
            "rotation": {
              "type": "number"
            },
            "adjust": {
              "type": "object",
              "properties": {
                "brightness": {
                  "type": "number"
                },
                "contrast": {
                  "type": "number"
                },
                "saturation": {
                  "type": "number"
                },
                "hue": {
                  "type": "number"
                },
                "temperature": {
                  "type": "number"
                },
                "tint": {
                  "type": "number"
                },
                "exposure": {
                  "type": "number"
                },
                "vignette": {
                  "type": "number"
                },
                "blur": {
                  "type": "number"
                },
                "grayscale": {
                  "type": "number"
                },
                "sepia": {
                  "type": "number"
                },
                "sharpen": {
                  "type": "number"
                },
                "grain": {
                  "type": "number"
                },
                "duotone": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "$ref": "#/$defs/Color"
                    },
                    {
                      "$ref": "#/$defs/Color"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "filter": {
                  "type": "string"
                }
              },
              "additionalProperties": {}
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            },
            "blend": {
              "$ref": "#/$defs/BlendMode"
            }
          },
          "required": ["type", "assetId", "mode"],
          "additionalProperties": {}
        }
      ]
    },
    "ColorRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "$var": {
              "type": "string"
            }
          },
          "required": ["$var"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "$style": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": ["$style"],
          "additionalProperties": {}
        }
      ]
    },
    "Stop": {
      "type": "object",
      "properties": {
        "pos": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Color"
            },
            {
              "$ref": "#/$defs/ColorRef"
            }
          ]
        }
      },
      "required": ["pos", "color"],
      "additionalProperties": {}
    },
    "Stroke": {
      "type": "object",
      "properties": {
        "fills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fill"
          }
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "align": {
          "type": "string",
          "enum": ["inside", "center", "outside"]
        },
        "dash": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "cap": {
          "type": "string",
          "enum": ["butt", "round", "square"]
        },
        "join": {
          "type": "string",
          "enum": ["miter", "round", "bevel"]
        },
        "miterLimit": {
          "type": "number"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "required": ["fills", "width", "align", "cap", "join"],
      "additionalProperties": {}
    }
  }
}
