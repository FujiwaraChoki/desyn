{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desyn.app/schema/v1/DesignStyles.json",
  "title": "DesignStyles",
  "type": "object",
  "properties": {
    "colors": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Id"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "$ref": "#/$defs/Color"
          }
        },
        "required": ["name", "value"],
        "additionalProperties": {}
      }
    },
    "text": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Id"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "style": {
            "$ref": "#/$defs/TextStyle"
          },
          "paragraph": {
            "type": "object",
            "properties": {
              "align": {
                "type": "string",
                "enum": ["left", "center", "right", "justify"]
              },
              "direction": {
                "type": "string",
                "enum": ["ltr", "rtl", "auto"]
              },
              "lineHeight": {
                "type": "object",
                "properties": {
                  "unit": {
                    "type": "string",
                    "enum": ["auto", "px", "percent"]
                  },
                  "value": {
                    "type": "number"
                  }
                },
                "required": ["unit", "value"],
                "additionalProperties": {}
              },
              "spacing": {
                "type": "number"
              },
              "indent": {
                "type": "number"
              },
              "list": {
                "type": "string",
                "enum": ["none", "bullet", "number"]
              }
            },
            "additionalProperties": {}
          }
        },
        "required": ["name", "style"],
        "additionalProperties": {}
      }
    },
    "effects": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/Id"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "effects": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Effect"
            }
          }
        },
        "required": ["name", "effects"],
        "additionalProperties": {}
      }
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": ["string", "number", "boolean"]
      }
    }
  },
  "required": ["colors", "text", "effects", "variables"],
  "additionalProperties": {},
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[a-z0-9]{12}$"
    },
    "Color": {
      "type": "string",
      "pattern": "^#(?:[0-9a-f]{6}|[0-9a-f]{8})$"
    },
    "TextStyle": {
      "type": "object",
      "properties": {
        "fontFamily": {
          "type": "string"
        },
        "fontWeight": {
          "type": "number"
        },
        "fontStyle": {
          "type": "string",
          "enum": ["normal", "italic"]
        },
        "fontSize": {
          "type": "number",
          "minimum": 0
        },
        "fills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fill"
          }
        },
        "letterSpacing": {
          "type": "number"
        },
        "textCase": {
          "type": "string",
          "enum": ["none", "upper", "lower", "title"]
        },
        "decoration": {
          "type": "string",
          "enum": ["none", "underline", "strikethrough"]
        },
        "link": {
          "type": "string"
        },
        "highlight": {
          "$ref": "#/$defs/Color"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "variations": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "fontFamily",
        "fontWeight",
        "fontStyle",
        "fontSize",
        "fills",
        "letterSpacing",
        "textCase",
        "decoration"
      ],
      "additionalProperties": {}
    },
    "Fill": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "solid"
            },
            "color": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Color"
                },
                {
                  "$ref": "#/$defs/ColorRef"
                }
              ]
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            },
            "blend": {
              "$ref": "#/$defs/BlendMode"
            }
          },
          "required": ["type", "color"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "linear"
            },
            "angle": {
              "type": "number"
            },
            "stops": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Stop"
              }
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            },
            "blend": {
              "$ref": "#/$defs/BlendMode"
            }
          },
          "required": ["type", "angle", "stops"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "radial"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "rx": {
              "type": "number"
            },
            "ry": {
              "type": "number"
            },
            "stops": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Stop"
              }
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            },
            "blend": {
              "$ref": "#/$defs/BlendMode"
            }
          },
          "required": ["type", "cx", "cy", "rx", "ry", "stops"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "conic"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "angle": {
              "type": "number"
            },
            "stops": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Stop"
              }
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            },
            "blend": {
              "$ref": "#/$defs/BlendMode"
            }
          },
          "required": ["type", "cx", "cy", "angle", "stops"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            },
            "assetId": {
              "$ref": "#/$defs/Id"
            },
            "mode": {
              "type": "string",
              "enum": ["fill", "fit", "tile", "stretch"]
            },
            "scale": {
              "type": "number"
            },
            "offsetX": {
              "type": "number"
            },
            "offsetY": {
              "type": "number"
            },
            "rotation": {
              "type": "number"
            },
            "adjust": {
              "type": "object",
              "properties": {
                "brightness": {
                  "type": "number"
                },
                "contrast": {
                  "type": "number"
                },
                "saturation": {
                  "type": "number"
                },
                "hue": {
                  "type": "number"
                },
                "temperature": {
                  "type": "number"
                },
                "tint": {
                  "type": "number"
                },
                "exposure": {
                  "type": "number"
                },
                "vignette": {
                  "type": "number"
                },
                "blur": {
                  "type": "number"
                },
                "grayscale": {
                  "type": "number"
                },
                "sepia": {
                  "type": "number"
                },
                "sharpen": {
                  "type": "number"
                },
                "grain": {
                  "type": "number"
                },
                "duotone": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "$ref": "#/$defs/Color"
                    },
                    {
                      "$ref": "#/$defs/Color"
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "filter": {
                  "type": "string"
                }
              },
              "additionalProperties": {}
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            },
            "blend": {
              "$ref": "#/$defs/BlendMode"
            }
          },
          "required": ["type", "assetId", "mode"],
          "additionalProperties": {}
        }
      ]
    },
    "ColorRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "$var": {
              "type": "string"
            }
          },
          "required": ["$var"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "$style": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": ["$style"],
          "additionalProperties": {}
        }
      ]
    },
    "BlendMode": {
      "type": "string",
      "enum": [
        "normal",
        "multiply",
        "screen",
        "overlay",
        "darken",
        "lighten",
        "color-dodge",
        "color-burn",
        "hard-light",
        "soft-light",
        "difference",
        "exclusion",
        "hue",
        "saturation",
        "color",
        "luminosity"
      ]
    },
    "Stop": {
      "type": "object",
      "properties": {
        "pos": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color": {
          "anyOf": [
            {
              "$ref": "#/$defs/Color"
            },
            {
              "$ref": "#/$defs/ColorRef"
            }
          ]
        }
      },
      "required": ["pos", "color"],
      "additionalProperties": {}
    },
    "Effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dropShadow"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "blur": {
              "type": "number",
              "minimum": 0
            },
            "spread": {
              "type": "number"
            },
            "color": {
              "$ref": "#/$defs/Color"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "x", "y", "blur", "spread", "color"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "innerShadow"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "blur": {
              "type": "number",
              "minimum": 0
            },
            "spread": {
              "type": "number"
            },
            "color": {
              "$ref": "#/$defs/Color"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "x", "y", "blur", "spread", "color"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "layerBlur"
            },
            "radius": {
              "type": "number",
              "minimum": 0
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "radius"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "backgroundBlur"
            },
            "radius": {
              "type": "number",
              "minimum": 0
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "radius"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "noise"
            },
            "amount": {
              "type": "number"
            },
            "scale": {
              "type": "number"
            },
            "mono": {
              "type": "boolean"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "amount", "scale", "mono"],
          "additionalProperties": {}
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "glow"
            },
            "radius": {
              "type": "number",
              "minimum": 0
            },
            "strength": {
              "type": "number"
            },
            "color": {
              "$ref": "#/$defs/Color"
            },
            "visible": {
              "type": "boolean"
            }
          },
          "required": ["type", "radius", "strength", "color"],
          "additionalProperties": {}
        }
      ]
    }
  }
}
