# /opt/desyn/secrets/landing.env -> landing-blue / landing-green (desyn.app). Runtime env of the Next.js server.
DESYN_EDITION=hosted
SITE_URL=${SITE_URL}
APP_URL=${APP_URL}
DOCS_URL=${DOCS_URL}
NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
NEXT_PUBLIC_DOCS_URL=${NEXT_PUBLIC_DOCS_URL}
NEXT_PUBLIC_CONVEX_URL=${NEXT_PUBLIC_CONVEX_URL}
NEXT_PUBLIC_CONVEX_SITE_URL=${NEXT_PUBLIC_CONVEX_SITE_URL}
CONVEX_URL=${NEXT_PUBLIC_CONVEX_URL}
CONVEX_SITE_URL=${NEXT_PUBLIC_CONVEX_SITE_URL}
NEXT_PUBLIC_POSTHOG_KEY=${NEXT_PUBLIC_POSTHOG_KEY:-}
NEXT_PUBLIC_POSTHOG_HOST=${NEXT_PUBLIC_POSTHOG_HOST}
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=${NEXT_PUBLIC_DATAFAST_WEBSITE_ID:-}
NEXT_PUBLIC_DATAFAST_DOMAIN=${NEXT_PUBLIC_DATAFAST_DOMAIN:-}
