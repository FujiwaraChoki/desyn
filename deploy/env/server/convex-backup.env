# /opt/desyn/secrets/convex-backup.env -> backup.sh / restore.sh, handed only to the Convex CLI container
# (`convex export`, `convex import`). A deploy key scoped to the prod deployment; server-env.py creates one
# named "desyn-hetzner" with the owner's CLI login when .env.keys has no CONVEX_DEPLOY_KEY_PROD yet.
CONVEX_DEPLOY_KEY=${CONVEX_DEPLOY_KEY_PROD}
