# /opt/desyn/secrets/web.env -> web-blue / web-green (app.desyn.app). Runtime env of the Next.js server, never sent
# to browsers. NEXT_PUBLIC_* values are also baked in at build time (deploy/env/public.env); repeating them here
# keeps server-side reads (route handlers, the Better Auth proxy to the Convex site URL) consistent.
DESYN_EDITION=hosted
SITE_URL=${SITE_URL}
APP_URL=${APP_URL}
DOCS_URL=${DOCS_URL}
NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}
NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
NEXT_PUBLIC_DOCS_URL=${NEXT_PUBLIC_DOCS_URL}
NEXT_PUBLIC_CONVEX_URL=${NEXT_PUBLIC_CONVEX_URL}
NEXT_PUBLIC_CONVEX_SITE_URL=${NEXT_PUBLIC_CONVEX_SITE_URL}
CONVEX_URL=${NEXT_PUBLIC_CONVEX_URL}
CONVEX_SITE_URL=${NEXT_PUBLIC_CONVEX_SITE_URL}
NEXT_PUBLIC_POSTHOG_KEY=${NEXT_PUBLIC_POSTHOG_KEY:-}
NEXT_PUBLIC_POSTHOG_HOST=${NEXT_PUBLIC_POSTHOG_HOST}
POSTHOG_HOST=${NEXT_PUBLIC_POSTHOG_HOST}
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=${NEXT_PUBLIC_DATAFAST_WEBSITE_ID:-}
NEXT_PUBLIC_DATAFAST_DOMAIN=${NEXT_PUBLIC_DATAFAST_DOMAIN:-}
LOG_LEVEL=info
