# /opt/desyn/secrets/backup.env -> backup.sh / restore.sh, handed to the pinned aws-cli container. Credentials of
# the desyn-backup IAM user (deploy/aws/iam-desyn-backup.json: write + read on desyn-prod-backups, read on
# desyn-prod-assets, no delete; retention is the bucket lifecycle rule in deploy/aws/backup-lifecycle.json).
AWS_ACCESS_KEY_ID=${BACKUP_AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${BACKUP_AWS_SECRET_ACCESS_KEY}
BACKUP_S3_BUCKET=${S3_BACKUP_BUCKET}
BACKUP_S3_PREFIX=backups/
BACKUP_S3_REGION=eu-central-1
# Server-side copy of the user-assets bucket into s3://<backup bucket>/assets-mirror/ (outside the expiring prefix).
BACKUP_ASSETS_BUCKET=${S3_BUCKET}
BACKUP_INCLUDE_FILE_STORAGE=1
BACKUP_LOCAL_RETENTION_DAYS=3
