# /opt/desyn/secrets/worker.env -> worker-blue / worker-green (render.desyn.app). The secret is the one
# convex-cloud-env.py generated for the prod Convex deployment (RENDER_WORKER_SECRET there), so Convex Cloud and
# the worker always agree.
RENDER_WORKER_SECRET=${RENDER_WORKER_SECRET_PROD}
RUST_LOG=info
