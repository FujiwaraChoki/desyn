{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BackupWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::desyn-prod-backups/*"
    },
    { "Sid": "BackupList", "Effect": "Allow", "Action": ["s3:ListBucket"], "Resource": "arn:aws:s3:::desyn-prod-backups" },
    {
      "Sid": "AssetsReadForSync",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::desyn-prod-assets", "arn:aws:s3:::desyn-prod-assets/*"]
    }
  ]
}
