# Environment of the Convex functions for a self-hosted install. Copy to deploy/compose/convex.env
# (ignored by deploy/compose/.gitignore), fill it, and push only the non-empty values with:
#   grep -E '^[A-Z0-9_]+=.+' deploy/compose/convex.env |
#     docker compose -f deploy/compose/desyn.selfhost.yml run --rm -T convex-tools env set --force
# CONVEX_URL / CONVEX_SITE_URL are provided by Convex itself and are not set here.
DESYN_EDITION=selfhost
SITE_URL=http://localhost:3001
APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
AI_KEY_ENCRYPTION_SECRET=
# Extra origins allowed to call the auth endpoints (comma list), e.g. a second domain in front of the app.
AUTH_TRUSTED_ORIGINS=
LOG_LEVEL=info
RENDER_WORKER_URL=http://worker:8080
# Same value as RENDER_WORKER_SECRET in deploy/compose/.env
RENDER_WORKER_SECRET=
# MinIO (bundled). S3_ENDPOINT must be reachable by browsers (presigned uploads) AND by the containers:
# use your LAN address or a domain, e.g. http://192.168.1.20:9000 or https://s3.example.com.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=desyn
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=desyn
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/desyn
S3_FORCE_PATH_STYLE=true
# Mail: "log" prints mails to the Convex logs; "smtp" with --profile mail uses Mailpit (UI on 127.0.0.1:8025).
MAIL_TRANSPORT=log
SMTP_URL=smtp://mailpit:1025
SES_FROM=Desyn <desyn@localhost>
# AI: bring your own keys (users can also add BYOK keys in settings), or local models with --profile ollama.
OPENROUTER_API_KEY=
FAL_AI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
