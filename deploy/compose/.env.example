# Desyn self-hosting: copy to deploy/compose/.env (git-ignored) and fill the empty secrets.
# Generate each secret with:  openssl rand -hex 32
# Telemetry is off: no PostHog/DataFast/Axiom keys are read by the self-hosted stack and the Convex beacon is
# disabled. DESYN_EDITION=selfhost unlocks every feature for non-commercial use.

# --- Required secrets ----------------------------------------------------------------------------------
POSTGRES_PASSWORD=
INSTANCE_SECRET=
MINIO_ROOT_USER=desyn
MINIO_ROOT_PASSWORD=
RENDER_WORKER_SECRET=
# Filled after the first start: docker compose -f deploy/compose/desyn.selfhost.yml exec convex-backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=

# --- Public URLs (what the browser uses; change when you put a reverse proxy / domain in front) ----------
DESYN_APP_URL=http://localhost:3000
DESYN_SITE_URL=http://localhost:3001
DESYN_DOCS_URL=http://localhost:3002
DESYN_CONVEX_URL=http://localhost:3210
DESYN_CONVEX_SITE_URL=http://localhost:3211

# --- Ports (host side) -----------------------------------------------------------------------------------
# 127.0.0.1 keeps everything local; 0.0.0.0 exposes the app, Convex and MinIO API on your network.
DESYN_BIND=127.0.0.1
DESYN_WEB_PORT=3000
DESYN_LANDING_PORT=3001
DESYN_DOCS_PORT=3002
DESYN_CONVEX_PORT=3210
DESYN_CONVEX_SITE_PORT=3211
DESYN_DASHBOARD_PORT=6791
DESYN_MINIO_PORT=9000
DESYN_MINIO_CONSOLE_PORT=9001
DESYN_MAILPIT_PORT=8025
DESYN_OLLAMA_PORT=11434

# --- Storage -------------------------------------------------------------------------------------------
S3_BUCKET=desyn

# --- Build ---------------------------------------------------------------------------------------------
# Parallel Rust compile jobs inside the image builds.
DESYN_BUILD_JOBS=4
