// Generates apps/ios/Packages/DesynKit/Sources/DesynKit/Generated/PagePresets.swift from @desyn/schema
// (PAGE_PRESETS + DESIGN_KIND_INFO), so the iOS app offers exactly the page sizes the web app and Convex know.
//
//   packages/schema/node_modules/.bin/tsx apps/ios/scripts/gen-presets.mts          # write
//   packages/schema/node_modules/.bin/tsx apps/ios/scripts/gen-presets.mts --check  # fail when stale
//
// Run from the repository root (any cwd works: paths are resolved from this file).
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { DESIGN_KIND_INFO } from "../../../packages/schema/src/kinds.ts";
import { PAGE_PRESETS } from "../../../packages/schema/src/presets.ts";

const here = dirname(fileURLToPath(import.meta.url));
const out = resolve(here, "../Packages/DesynKit/Sources/DesynKit/Generated/PagePresets.swift");

/** Swift string literal (presets are ASCII, but escape defensively). */
function str(value: string): string {
  return `"${value.replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\n/g, "\\n")}"`;
}

/** Swift Double literal: integers stay integral, others keep up to 6 decimals. */
function num(value: number): string {
  if (!Number.isFinite(value)) throw new Error(`non-finite number ${value}`);
  const fixed = Number.isInteger(value) ? value.toFixed(1) : String(Number(value.toFixed(6)));
  return fixed.includes(".") || fixed.includes("e") ? fixed : `${fixed}.0`;
}

function optional<T>(value: T | undefined, render: (v: T) => string): string {
  return value === undefined ? "nil" : render(value);
}

const presetLines = PAGE_PRESETS.map((p) => {
  const safe = optional(
    p.safeArea,
    (s) => `SafeArea(top: ${num(s.top)}, right: ${num(s.right)}, bottom: ${num(s.bottom)}, left: ${num(s.left)})`,
  );
  const physical = optional(
    p.physical,
    (ph) => `PhysicalSize(width: ${num(ph.width)}, height: ${num(ph.height)}, unit: ${str(ph.unit)})`,
  );
  return [
    "        PagePreset(",
    `            id: ${str(p.id)}, label: ${str(p.label)}, kind: DesignKind(rawValue: ${str(p.kind)}),`,
    `            category: .${p.category}, platform: ${optional(p.platform, str)},`,
    `            width: ${num(p.width)}, height: ${num(p.height)}, unit: ${str(p.unit)},`,
    `            dpi: ${optional(p.dpi, num)}, bleed: ${optional(p.bleed, num)},`,
    `            safeArea: ${safe}, physical: ${physical}`,
    "        ),",
  ].join("\n");
});

const kindLines = Object.values(DESIGN_KIND_INFO).map((k) =>
  [
    "        DesignKindInfo(",
    `            kind: DesignKind(rawValue: ${str(k.kind)}), label: ${str(k.label)}, icon: ${str(k.icon)},`,
    `            description: ${str(k.description)},`,
    `            defaultPreset: ${str(k.defaultPreset)}, multiPage: ${k.multiPage}`,
    "        ),",
  ].join("\n"),
);

const source = `// Generated by apps/ios/scripts/gen-presets.mts from packages/schema (PAGE_PRESETS, DESIGN_KIND_INFO).
// Do not edit by hand: change packages/schema and run the generator.

public extension PagePreset {
    /// Every page preset of @desyn/schema, in the same order (${PAGE_PRESETS.length} presets).
    static let all: [PagePreset] = [
${presetLines.join("\n")}
    ]
}

public extension DesignKindInfo {
    /// DESIGN_KIND_INFO of @desyn/schema (${Object.keys(DESIGN_KIND_INFO).length} kinds).
    static let all: [DesignKindInfo] = [
${kindLines.join("\n")}
    ]
}
`;

if (process.argv.includes("--check")) {
  let current = "";
  try {
    current = readFileSync(out, "utf8");
  } catch {
    // missing file is stale
  }
  if (current !== source) {
    console.error(`${out} is stale; run apps/ios/scripts/gen-presets.mts`);
    process.exit(1);
  }
  console.log(`PagePresets.swift is up to date (${PAGE_PRESETS.length} presets)`);
} else {
  writeFileSync(out, source);
  console.log(`wrote ${out} (${PAGE_PRESETS.length} presets, ${Object.keys(DESIGN_KIND_INFO).length} kinds)`);
}
