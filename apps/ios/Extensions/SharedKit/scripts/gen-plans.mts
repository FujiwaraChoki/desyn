// Generates apps/ios/Extensions/SharedKit/Sources/SharedKit/Generated/PlanFeaturesData.swift from @desyn/schema
// (PLANS, read from config/plans.json), so the app gates the work it does on the device (local exports) with the
// same plan features the server enforces, also when it is offline.
//
//   packages/schema/node_modules/.bin/tsx apps/ios/Extensions/SharedKit/scripts/gen-plans.mts          # write
//   packages/schema/node_modules/.bin/tsx apps/ios/Extensions/SharedKit/scripts/gen-plans.mts --check  # fail when stale
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { FEATURE_KEYS, PLAN_IDS, PLANS } from "../../../../../packages/schema/src/plans.ts";

const here = dirname(fileURLToPath(import.meta.url));
const out = resolve(here, "../Sources/SharedKit/Generated/PlanFeaturesData.swift");

function str(value: string): string {
  return `"${value.replace(/\\/g, "\\\\").replace(/"/g, '\\"')}"`;
}

const planLines = PLAN_IDS.map((id) => {
  const features = PLANS.plans[id].features;
  const entries = [...FEATURE_KEYS]
    .sort()
    .map((key) => `            ${str(key)}: ${features[key] ? "true" : "false"},`);
  return `        ${str(id)}: [\n${entries.join("\n")}\n        ],`;
});

const source = `// Generated by apps/ios/Extensions/SharedKit/scripts/gen-plans.mts from config/plans.json (via @desyn/schema). Do not edit.

public extension PlanFeatures {
    /// Plan id -> feature key -> included (${PLAN_IDS.length} plans, ${FEATURE_KEYS.length} features).
    static let table: [String: [String: Bool]] = [
${planLines.join("\n")}
    ]
}
`;

if (process.argv.includes("--check")) {
  const current = readFileSync(out, "utf8");
  if (current !== source) {
    console.error(`${out} is stale; run without --check to regenerate.`);
    process.exit(1);
  }
  console.log("PlanFeaturesData.swift is up to date.");
} else {
  writeFileSync(out, source);
  console.log(`wrote ${out} (${PLAN_IDS.length} plans, ${FEATURE_KEYS.length} features)`);
}
