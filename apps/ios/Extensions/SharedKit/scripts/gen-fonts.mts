// Generates apps/ios/Extensions/SharedKit/Sources/SharedKit/Generated/FontCatalogData.swift from @desyn/schema
// (FONT_CATALOG + FONT_PAIRINGS), so the iOS font picker offers exactly the families the web app, the AI and the
// engine know.
//
//   packages/schema/node_modules/.bin/tsx apps/ios/Extensions/SharedKit/scripts/gen-fonts.mts          # write
//   packages/schema/node_modules/.bin/tsx apps/ios/Extensions/SharedKit/scripts/gen-fonts.mts --check  # fail when stale
import { readFileSync, writeFileSync } from "node:fs";
import { dirname, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { FONT_CATALOG, FONT_PAIRINGS } from "../../../../../packages/schema/src/fonts.ts";

const here = dirname(fileURLToPath(import.meta.url));
const out = resolve(here, "../Sources/SharedKit/Generated/FontCatalogData.swift");

function str(value: string): string {
  return `"${value.replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\n/g, "\\n")}"`;
}

function strings(values: readonly string[]): string {
  return `[${values.map(str).join(", ")}]`;
}

const categories: Record<string, string> = {
  "sans-serif": "sansSerif",
  serif: "serif",
  display: "display",
  handwriting: "handwriting",
  monospace: "monospace",
};

const familyLines = FONT_CATALOG.map((f) => {
  const wght = f.axes?.find((a) => a.tag === "wght");
  const variable = wght ? `${wght.min}...${wght.max}` : "nil";
  return `        FontFamily(family: ${str(f.family)}, category: .${categories[f.category]}, weights: [${f.weights.join(", ")}], italic: ${f.italic}, variableWeights: ${variable}, pairsWith: ${strings(f.pairsWith)}, tags: ${strings(f.tags)}),`;
});

const pairingLines = FONT_PAIRINGS.map(
  (p) =>
    `        FontPairing(id: ${str(p.id)}, heading: ${str(p.heading)}, body: ${str(p.body)}, headingWeight: ${p.headingWeight}, bodyWeight: ${p.bodyWeight}, moods: ${strings(p.moods)}, goodFor: ${strings(p.goodFor)}),`,
);

const source = `// Generated by apps/ios/Extensions/SharedKit/scripts/gen-fonts.mts from packages/schema/src/fonts.ts. Do not edit.

public extension FontFamily {
    /// The curated Google Fonts catalog (${FONT_CATALOG.length} families).
    static let catalog: [FontFamily] = [
${familyLines.join("\n")}
    ]
}

public extension FontPairing {
    /// Heading / body pairings (${FONT_PAIRINGS.length}).
    static let all: [FontPairing] = [
${pairingLines.join("\n")}
    ]
}
`;

if (process.argv.includes("--check")) {
  const current = readFileSync(out, "utf8");
  if (current !== source) {
    console.error(`${out} is stale; run without --check to regenerate.`);
    process.exit(1);
  }
  console.log("FontCatalogData.swift is up to date.");
} else {
  writeFileSync(out, source);
  console.log(`wrote ${out} (${FONT_CATALOG.length} families, ${FONT_PAIRINGS.length} pairings)`);
}
