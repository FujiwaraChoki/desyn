# Public build-time configuration (inlined into client bundles). Hosted values: deploy/env/public.env.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3212
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3213
NEXT_PUBLIC_APP_URL=http://localhost:4100
NEXT_PUBLIC_SITE_URL=https://desyn.app
NEXT_PUBLIC_DOCS_URL=https://docs.desyn.app
NEXT_PUBLIC_DESYN_EDITION=selfhost
# Optional analytics (off when empty). PostHog EU host by default.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_DATAFAST_WEBSITE_ID=
NEXT_PUBLIC_DATAFAST_DOMAIN=
# Server runtime (never sent to browsers).
# CONVEX_SITE_URL overrides NEXT_PUBLIC_CONVEX_SITE_URL for the /api/auth proxy (e.g. an internal URL).
CONVEX_SITE_URL=
# Web Vitals to Axiom (off unless both are set).
AXIOM_TOKEN=
AXIOM_DATASET=
AXIOM_URL=
AXIOM_ORG_ID=
# Asset hosts added to the CSP (MinIO/R2 self-hosting); build time.
S3_PUBLIC_BASE_URL=
S3_ENDPOINT=
# "off" leaves security headers to the reverse proxy (hosted nginx sets an equivalent CSP); build time.
DESYN_SECURITY_HEADERS=
